XENO_CONFIG:=/usr/xenomai/bin/xeno-config
XENOMAI_CFLAGS:=$(shell $(XENO_CONFIG) --skin=posix --cflags)
ADDITIONAL_CFLAGS= -mtune=cortex-a8 -mfloat-abi=hard -mfpu=neon -ftree-vectorize -O2 -ffast-math -fsingle-precision-constant  -march=armv7-a -DTHREADED_IO
